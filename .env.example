# Copy to .env.local for development. Never commit real secrets.

# Postgres connection (Supabase: Project Settings -> Database -> Connection string, "Transaction pooler" for Vercel)
DATABASE_URL=postgres://everglow:everglow@localhost:5432/everglow

# Public site URL (canonical links, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Field-level encryption of customer personal data. 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing ENCRYPTION_KEY means losing access to encrypted customer data: store it in a password manager.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# First owner account created by `npm run db:seed` (change the password after first login)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=

# File storage for uploaded photos: "local" (development) or "supabase" (production)
STORAGE_DRIVER=local
SUPABASE_URL=
# Service role key — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
